# Application image downloaded on the server (or pin a sha tag / digest).
APP_IMAGE=ghcr.io/mhhoeper/neolink-sample-app:latest
# Both empty: no login. Set both for HTTP Basic authentication.
# Plain KEY=value syntax, without shell quotes or inline comments.
WEB_USERNAME=
WEB_PASSWORD=
LIVE_VIDEO_MODE=auto
CACHE_MAX_GB=2
EVENT_CACHE_SECONDS=60
